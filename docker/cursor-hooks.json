    "beforeShellExecution": [{ "command": "/usr/local/bin/ocr-sandbox tool-guard cursor", "timeout": 10, "failClosed": true }],
    "beforeReadFile": [{ "command": "/usr/local/bin/ocr-sandbox tool-guard cursor", "timeout": 10, "failClosed": true }],
    "beforeMCPExecution": [{ "command": "/usr/local/bin/ocr-sandbox tool-guard cursor", "timeout": 10, "failClosed": true }]
  }
}
