FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --child-concurrency=2 --network-concurrency=4
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY assets/mascot.svg assets/favicon.svg ./assets/
ENV VITE_SETUP_API_BASE=/api
ENV VITE_OCR_API_TOKEN=__OCR_API_TOKEN__
RUN pnpm build

FROM nginx:1.31-alpine
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/web-entrypoint.sh /docker-entrypoint.d/40-ocr-token.sh
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-ocr-token.sh
EXPOSE 1421
