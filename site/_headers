# Cloudflare Workers static assets headers: https://developers.cloudflare.com/workers/static-assets/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/site.webmanifest
  Content-Type: application/manifest+json

# Link previews fetch the share image with ?v=, which is bumped when it changes; a day is enough for the
# rest. Other images keep the default revalidation because their URLs carry no version.
/og.png
  Cache-Control: public, max-age=86400
