{
  "name": "OpenCodeReview",
  "short_name": "OpenCodeReview",
  "description": "Self-hosted AI code review on the Claude or ChatGPT plan you already have.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#111111",
